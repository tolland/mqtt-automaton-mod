<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
  <Appenders>
    <Console name="Console">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n" />
    </Console>
    <File name="MqttBotFile" fileName="run/logs/mqttbot.log" append="false">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n" />
    </File>
  </Appenders>
  <Loggers>
    <Logger name="org.limepepper.mqttbot" level="trace" additivity="false">
      <AppenderRef ref="Console" />
      <AppenderRef ref="MqttBotFile" />
    </Logger>
    <Root level="info">
      <AppenderRef ref="Console" />
    </Root>
  </Loggers>
</Configuration>
