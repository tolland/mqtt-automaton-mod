  "name": "Mqtt automaton Mod",
  "description": "This mod bridges client chat to mqtt topic!",
  "authors": [
    "Tolland"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/tolland/mqtt-bot-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/modid/icon.png",
  "environment": "*",
